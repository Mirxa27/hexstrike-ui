# HexStrike UI Environment Variables

# Node Environment
NODE_ENV=production

# ── HexStrike API (baked into static bundle at `npm run build` / Docker build)
# Production Docker (nginx proxies same-origin `/api/` → backend):
#   VITE_HEXSTRIKE_URL=/api
# Local backend on this machine (browser calls backend directly — backend must allow CORS):
#   VITE_HEXSTRIKE_URL=http://127.0.0.1:8888
# `npm run dev`: leave both unset to use same-origin `/api/*` (Vite proxy below).
VITE_HEXSTRIKE_URL=
VITE_API_BASE_URL=

# Vite dev server only: where `npm run dev` proxies `/api/*` (matches Docker behavior).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8888
# Optional split form instead of VITE_DEV_PROXY_TARGET:
# VITE_DEV_BACKEND_HOST=127.0.0.1
# VITE_DEV_BACKEND_PORT=8888

VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME=HexStrike AI
VITE_APP_URL=http://localhost:4173

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_TELEMETRY=false

# Rate Limiting
VITE_RATE_LIMIT_REQUESTS=100
VITE_RATE_LIMIT_WINDOW=60000

# Logging
VITE_LOG_LEVEL=info
VITE_DEBUG=false

# Security
VITE_ENABLE_CSP=true
VITE_ENABLE_FRAME_GUARD=true
